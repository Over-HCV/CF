{
  // Solo en la terminal de VS Code de este proyecto:
  //   PATH    → run / new / san funcionan sin "./"
  //   CF_ROOT → ~/.zshrc carga los atajos r / n / s (.tools/aliases.zsh)
  "terminal.integrated.env.osx": {
    "PATH": "${workspaceFolder}:${env:PATH}",
    "CF_ROOT": "${workspaceFolder}"
  },

  "C_Cpp.default.compilerPath": "/opt/homebrew/bin/g++-15",
  // new / run / san son scripts de bash (sin esto, "new" se confunde con el header <new> de C++)
  "files.associations": {
    "new": "shellscript",
    "run": "shellscript",
    "san": "shellscript"
  },
  "files.exclude": {
    "build": true
  },
  // Los enunciados se abren siempre renderizados (fórmulas e imágenes)
  "workbench.editorAssociations": {
    "**/probs/*/stmt.md": "vscode.markdown.preview.editor"
  },
  "markdown.math.enabled": true,
  // Guarda solo al cambiar de foco (p. ej. al ir a la terminal a correr r)
  "files.autoSave": "onFocusChange",
  "r.lsp.promptToInstall": false
}
