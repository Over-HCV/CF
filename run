#!/usr/bin/env bash
# Uso:
#   run probs/69A           compila probs/69A/sol.cpp y prueba TODOS los ejemplos
#   run 69A                 lo mismo
#   run                     dentro de probs/69A/, lo mismo
#   run x.cpp in.txt        ejecuta x.cpp solo con esa entrada
#
# Compila con g++-15 en modo depuración (como el juez + chequeos extra).
# Lo que imprimas con dbg() solo se muestra en los ejemplos que fallan.
set -uo pipefail
root="$(cd "$(dirname "$0")" && pwd)"

a="${1:-.}"; a="${a%/}"
if   [[ -f "$a" ]];                    then src="$a"
elif [[ -f "$a/sol.cpp" ]];            then src="$a/sol.cpp"
elif [[ -f "$root/probs/$a/sol.cpp" ]]; then src="$root/probs/$a/sol.cpp"
else echo "No encuentro el problema '$a' (¿existe probs/$a/sol.cpp?)"; exit 1
fi

dir="$(cd "$(dirname "$src")" && pwd)"
mkdir -p "$root/build"
bin="$root/build/$(basename "$dir")_$(basename "${src%.cpp}")"

/opt/homebrew/bin/g++-15 -std=c++23 -O2 \
  -Wall -Wextra -Wshadow -Wconversion \
  -DLOCAL -D_GLIBCXX_DEBUG -D_GLIBCXX_DEBUG_PEDANTIC \
  -Wl,-stack_size,0x10000000 \
  "$src" -o "$bin" || { echo "✘ No compiló"; exit 1; }

# Entrada específica
if [[ $# -ge 2 ]]; then "$bin" < "$2"; exit; fi

# Sin ejemplos: lee del teclado
if [[ ! -f "$dir/1.in" ]]; then
  echo "(sin ejemplos: escribe la entrada y termina con Ctrl+D)"
  "$bin"; exit
fi

# Con ejemplos: probar todos y comparar (ignorando espacios y saltos de línea extra)
norm() { tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//'; }
indent() { sed 's/^/  /'; }
err="$(mktemp)"; trap 'rm -f "$err"' EXIT

ok=0; total=0; i=1
while [[ -f "$dir/$i.in" ]]; do
  total=$((total + 1))
  got="$("$bin" < "$dir/$i.in" 2>"$err")"; code=$?
  if [[ $code -eq 0 && "$(norm <<<"$got")" == "$(norm < "$dir/$i.out")" ]]; then
    echo "✔ Ejemplo $i"; ok=$((ok + 1))
  else
    if [[ $code -ne 0 ]]; then
      echo "✘ Ejemplo $i: el programa falló (código $code)"
    else
      echo "✘ Ejemplo $i: respuesta incorrecta"
    fi
    echo "  --- entrada";   indent < "$dir/$i.in"
    echo "  --- esperado";  indent < "$dir/$i.out"
    echo "  --- tu salida"; indent <<<"$got"
    if [[ -s "$err" ]]; then echo "  --- dbg / errores"; indent < "$err"; fi
  fi
  i=$((i + 1))
done
echo "$ok/$total ejemplos correctos"
[[ $ok -eq $total ]]
